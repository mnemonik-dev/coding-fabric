[Unit]
Description=fabric-watchdog timer — run alert checks every 5 minutes
Documentation=https://github.com/mnemonic-org/coding-fabric

[Timer]
# Fire every 5 minutes; jitter up to 30s to avoid thundering-herd on boot.
OnCalendar=*:0/5
RandomizedDelaySec=30s
# First run 5 minutes after boot (not immediately, to let services settle).
OnBootSec=5min
# Catch up on missed runs if the system was suspended.
Persistent=true
Unit=fabric-watchdog.service

[Install]
WantedBy=timers.target
