# Rendered from infrastructure/secrets/secrets.sops.yml. Do not edit on VM.
# The release workflow changes only immutable image lines during an approved apply.
FACILITATOR_IMAGE=ghcr.io/mnemonik-dev/universal-paywall-facilitator:UNSET
APPROVAL_UI_IMAGE=ghcr.io/mnemonik-dev/universal-paywall-approval-ui:UNSET
MCP_IMAGE=ghcr.io/mnemonik-xyz/mnemonic-mcp:UNSET
FACILITATOR_PORT=8403
MCP_PORT=3001
CADDY_NETWORK_NAME=vaultwarden_vaultwarden
ARC_RPC_URL={{ universal_paywall_staging_arc_rpc_url }}
CHAIN_ID={{ universal_paywall_staging_chain_id }}
NETWORK={{ universal_paywall_staging_network }}
USDC_ADDRESS={{ universal_paywall_staging_usdc_address }}
USDC_EIP712_NAME=USDC
USDC_EIP712_VERSION=2
SERVICE_ID=mnemonic-anchor-staging
SERVICE_PAY_TO={{ universal_paywall_staging_pay_to }}
FACILITATOR_KEY={{ universal_paywall_staging_facilitator_key }}
SESSION_STAKE_VAULT_FACTORY={{ universal_paywall_staging_session_stake_vault_factory | default('0x0000000000000000000000000000000000000000') }}
SESSION_RAIL_FROM_BLOCK=0
QUOTE_TTL_SECONDS=300
MAX_SESSION_SECONDS=604800
SERVICE_API_KEYS={{ universal_paywall_staging_service_api_key }}
RECEIPT_KEY_ID=staging-2026-07
EXACT_PAYMENTS_ENABLED=1
MCP_PUBLIC_BASE_URL=https://{{ universal_paywall_staging_domain }}
UNIVERSAL_PAYWALL_URL={{ universal_paywall_staging_facilitator_url }}
UNIVERSAL_PAYWALL_API_KEY={{ universal_paywall_staging_service_api_key }}
# Must be string-identical to the facilitator's NETWORK: session-service
# compares binding.network with a raw equality check, so a CAIP-2 alias
# (eip155:5042002) fails with network_mismatch even for the same chain.
UNIVERSAL_PAYWALL_NETWORK={{ universal_paywall_staging_network }}
UNIVERSAL_PAYWALL_ASSET={{ universal_paywall_staging_usdc_address }}
UNIVERSAL_PAYWALL_PAY_TO={{ universal_paywall_staging_pay_to }}
UNIVERSAL_PAYWALL_APPROVAL_URL_BASE=https://{{ universal_paywall_staging_domain }}
UNIVERSAL_PAYWALL_EIP712_NAME=USDC
UNIVERSAL_PAYWALL_EIP712_VERSION=2
UNIVERSAL_PAYWALL_CHAIN_RPC_URL={{ universal_paywall_staging_arc_rpc_url }}
UNIVERSAL_PAYWALL_CHAIN_NAME=Arc Testnet
UNIVERSAL_PAYWALL_CHAIN_CURRENCY_SYMBOL=USDC
UNIVERSAL_PAYWALL_CHAIN_CURRENCY_DECIMALS=18
MNEMONIC_KEYPAIR_PATH=/keypair/id.json
DATABASE_PATH=/data/attestations.db
MCP_JWT_SECRET={{ universal_paywall_staging_mcp_jwt_secret }}
MCP_REFRESH_SALT={{ universal_paywall_staging_mcp_refresh_salt }}
# Paid anchoring requires the full storage mode and the exact x402 rail.
# Without these the MCP boots local-only and rejects `mode: participate`
# with UnsupportedMode, so the external staging gate can never run.
STORAGE_MODE=full
PAYMENT_MODE=x402
ANCHORING_NETWORK=devnet
SOLANA_RPC_URL={{ universal_paywall_staging_solana_rpc_url }}
IRYS_GATEWAY_URL={{ universal_paywall_staging_irys_url }}
