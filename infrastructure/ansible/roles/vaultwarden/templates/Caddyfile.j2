{
  log {
    level {{ vaultwarden_caddy_log_level }}
  }
  storage file_system /data/caddy
}

{{ vaultwarden_tailnet_domain }}:8443 {
  tls internal

  reverse_proxy vaultwarden:80 {
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-Host {host}

    # Health check endpoint
    health http://vaultwarden:80/api/health
    health_uri /api/health
    health_interval 10s
    health_timeout 5s
  }

  # Disable client body size limit for Vaultwarden attachments
  request_body /

  # Add HSTS header for tailnet domain
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  header X-Content-Type-Options "nosniff"
  header X-Frame-Options "SAMEORIGIN"
  header X-XSS-Protection "1; mode=block"
  header Referrer-Policy "same-origin"

  log {
    level {{ vaultwarden_caddy_log_level }}
    output stdout
    format console
  }
}

127.0.0.1:2019 {
  metrics
}

# Optional: snippets injected by other roles (kaneo, future apps)
import /etc/caddy/conf.d/*.conf
