version: '3.8'

services:
  kaneo:
    image: {{ kaneo_image }}
    container_name: kaneo-kaneo-1
    restart: unless-stopped
    environment:
      DATABASE_URL: "sqlite:///opt/kaneo/data/kaneo.db"
      PORT: "3030"
      KANEO_API_TOKEN: "{{ kaneo_api_token }}"
      LOG_LEVEL: "info"
    volumes:
      - ./data:/opt/kaneo/data
    networks:
      - kaneo
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3030{{ kaneo_health_endpoint }}"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    expose:
      - "3030"

networks:
  kaneo:
    driver: bridge

volumes:
  kaneo_data:
    driver: local
