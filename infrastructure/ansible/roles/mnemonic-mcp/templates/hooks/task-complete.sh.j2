#!/bin/bash

set -euo pipefail

# task-complete.sh
# Trigger point 3: task completion (all tasks passing)
# Invokes mnemonic_sign_memory with full-mode receipt if MNEMONIC_MODE=full
# Parent: tech-spec attestation

FEATURE=""
ARTEFACT=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --feature)
      FEATURE="$2"
      shift 2
      ;;
    --artefact)
      ARTEFACT="$2"
      shift 2
      ;;
    *)
      echo "Usage: $0 --feature <name> --artefact <path>"
      exit 1
      ;;
  esac
done

if [[ -z "$FEATURE" ]] || [[ -z "$ARTEFACT" ]]; then
  echo "task-complete.sh: FEATURE and ARTEFACT required" >&2
  exit 1
fi

WORK_DIR="work/$FEATURE"
ATTESTATIONS_FILE="$WORK_DIR/attestations.yml"

mkdir -p "$WORK_DIR"

# Verify parent (tech-spec attestation) exists
if [[ ! -f "$ATTESTATIONS_FILE" ]] || ! grep -q "tech_spec:" "$ATTESTATIONS_FILE"; then
  echo "task-complete.sh: parent attestation (tech_spec) not found" >&2
  exit 1
fi

PARENT_ID=$(grep -A1 "tech_spec:" "$ATTESTATIONS_FILE" | grep "attestation_id:" | awk '{print $NF}')
if [[ -z "$PARENT_ID" ]]; then
  echo "task-complete.sh: failed to extract parent attestation_id" >&2
  exit 1
fi

# Determine mode: check for protocol-qa.env or MNEMONIC_MODE env var
MODE="local"
if [[ -f "{{ mnemonic_mcp_config_dir }}/protocol-qa.env" ]] && grep -q "MNEMONIC_MODE=full" "{{ mnemonic_mcp_config_dir }}/protocol-qa.env"; then
  MODE="full"
fi
if [[ "${MNEMONIC_MODE:-}" == "full" ]]; then
  MODE="full"
fi

# Invoke mnemonic_sign_memory with parent reference
if ! ATTESTATION_OUTPUT=$(mnemonic_sign_memory \
  --content "tasks completed: $FEATURE" \
  --parent "$PARENT_ID" \
  --tags "task-complete" "$FEATURE" 2>&1); then
  echo "task-complete.sh: mnemonic_sign_memory failed" >&2
  exit 1
fi

# Extract attestation_id from output
ATTESTATION_ID=$(echo "$ATTESTATION_OUTPUT" | grep -oP 'attestation_id[=:]?\s*\K[a-f0-9-]+' | head -1)
if [[ -z "$ATTESTATION_ID" ]]; then
  echo "task-complete.sh: failed to extract attestation_id" >&2
  exit 1
fi

# In full mode, capture full-mode receipt fields
RECEIPT_DATA="
  attestation_id: $ATTESTATION_ID
  parent_id: $PARENT_ID
  timestamp: $(date -u +%Y-%m-%dT%H:%M:%SZ)
  artefact: $ARTEFACT
  mode: $MODE"

if [[ "$MODE" == "full" ]]; then
  # Extract Solana and Arweave txids from full-mode receipt
  SOLANA_TX=$(echo "$ATTESTATION_OUTPUT" | grep -oP 'solana_tx[=:]?\s*\K[a-zA-Z0-9]+' | head -1 || echo "")
  ARWEAVE_TX=$(echo "$ATTESTATION_OUTPUT" | grep -oP 'arweave_tx[=:]?\s*\K[a-zA-Z0-9]+' | head -1 || echo "")
  if [[ -n "$SOLANA_TX" ]]; then
    RECEIPT_DATA+="
  solana_tx: $SOLANA_TX"
  fi
  if [[ -n "$ARWEAVE_TX" ]]; then
    RECEIPT_DATA+="
  arweave_tx: $ARWEAVE_TX"
  fi
fi

# Record in attestations.yml
cat >> "$ATTESTATIONS_FILE" <<EOF
task_complete:$RECEIPT_DATA
EOF

echo "task-complete.sh: attestation created: $ATTESTATION_ID (parent: $PARENT_ID, mode: $MODE)"
exit 0
