# infrastructure/secrets/secrets.sops.yml.template
#
# Template for encrypted secrets file. Operator workflow:
#   cp infrastructure/secrets/secrets.sops.yml.template \
#      infrastructure/secrets/secrets.sops.yml
#   sops -e -i infrastructure/secrets/secrets.sops.yml
#   sops infrastructure/secrets/secrets.sops.yml      # opens $EDITOR; fill values; save -> auto-encrypts
#
# After encryption, secrets.sops.yml is committed to git (encrypted-at-rest,
# safe in a public repo). Only the age private key (in
# ~/.config/sops/age/keys.txt locally and SOPS_AGE_KEY GitHub Actions secret)
# must stay private.
#
# Last cleaned: 2026-05-20 — added claude_credentials (subscription auth);
# removed solana_devnet_keypair + irys_testnet_private_key (mnemonic-mcp
# descoped, see decisions.md Round 2).

# === Hetzner Cloud ===
# API token (R/W). Mirrored in GH secret HCLOUD_TOKEN.
hcloud_token: "YOUR_HCLOUD_TOKEN_HERE"

# === Tailscale ===
# Auth key — used by `tailscale` Ansible role to join VM to your tailnet.
# Generate at: https://login.tailscale.com/admin/settings/keys
# Settings: reusable, ephemeral, pre-approved, tag=tag:fabric, TTL 90d.
# (CI uses separate OAuth client + secret in GH Actions secrets, not this.)
tailscale_auth_key: "tskey-auth-YOUR_AUTH_KEY_HERE"

# === Vaultwarden ===
# Initial admin password — for first login at https://vault.mnemonic-fabric.ts/admin
#   openssl rand -base64 32
vaultwarden_initial_admin_password: "YOUR_LONG_RANDOM_PASSWORD_HERE"
# Admin API token — long random string used by `/admin` endpoint.
#   openssl rand -hex 32
vaultwarden_admin_token: "YOUR_LONG_RANDOM_ADMIN_TOKEN_HERE"

# === Telegram ===
# Bot token from @BotFather. Mirrored in GH secret TELEGRAM_BOT_TOKEN
# for early CI alerts (before Ansible loads sops).
telegram_bot_token: "YOUR_TELEGRAM_BOT_TOKEN_HERE"
# Supergroup forum chat_id from @RawDataBot. Mirrored in GH secret.
telegram_forum_chat_id: "-1001YOUR_FORUM_CHAT_ID"
# Optional. If pre-created 'ops' topic via Telegram UI and want CI alerts
# routed there before telegram-init role auto-creates topics, set thread_id.
# Otherwise leave "0" — Ansible discovers + populates inventory at deploy time.
telegram_ops_thread_id: "0"

# === Anthropic — Claude (subscription preferred via OAuth, API key fallback) ===
# Subscription auth: long-lived OAuth token from `claude setup-token`.
# Generate on laptop where you're logged into Claude Pro/Max:
#   claude setup-token  →  browser OAuth → terminal prints token ONCE
# Format: sk-ant-oat01-<long-base64>. Scope: user:inference only (can't
# read account info or modify subscription — minimal blast radius if leaked).
# Refresh: re-run setup-token quarterly (tokens last 6-12mo) and re-encrypt.
claude_code_oauth_token: "sk-ant-oat01-YOUR_OAUTH_TOKEN_HERE"

# Optional fallback — pay-per-token API mode. Leave empty to disable fallback.
# Activated if OAuth token auth fails (e.g. token revoked / expired).
# Note: per-token API mode bypasses subscription quota → real $ cost.
anthropic_api_key: ""

# === OpenAI — Codex (optional, only for demo-client topic) ===
# Leave empty to disable demo-client engine; topic will be inactive.
openai_api_key: ""

# === Deepgram — voice transcription (optional) ===
# Leave empty to disable voice-message transcription in topics.
deepgram_api_key: ""

# === GitHub ===
# Fine-grained PAT for recursive self-hosting via mnemonic-loop merges.
# Scopes: contents:R/W on 6 mnemonic-* repos + mnemonic-loop, issues:R/W,
# pull-requests:R/W, workflows:R/W.
# https://github.com/settings/personal-access-tokens/new
github_deploy_pat: "github_pat_YOUR_FINE_GRAINED_PAT_HERE"

# === Restic backups ===
# Off-site repo URL. Hetzner Storage Box (SFTP) or any S3-compatible.
# Examples:
#   sftp:u12345@u12345.your-storagebox.de:/restic
#   s3:s3.amazonaws.com/your-bucket/coding-fabric
restic_repository: "sftp:USER@HOST:/restic"
# Strong random — encrypts the backup repo itself.
# LOSS = backups unrecoverable. Store in password manager AND paper backup.
#   openssl rand -base64 48
restic_password: "YOUR_LONG_RANDOM_RESTIC_PASSWORD_HERE"

# === Kaneo ===
# Current upstream uses Postgres + AUTH_SECRET (no static API token).
# Both required by the role; generate before first deploy:
#   openssl rand -hex 32   # AUTH_SECRET (JWT signing, >= 32 chars)
#   openssl rand -base64 24  # Postgres password (any length >= 12)
kaneo_auth_secret: "YOUR_HEX_32_BYTES_AUTH_SECRET_HERE"
kaneo_postgres_password: "YOUR_POSTGRES_PASSWORD_HERE"
# Optional: public domain for Kaneo (real DNS + LE cert). Empty = tailnet-only.
# Requires a DNS A record pointing the domain at the VM's public IPv4 and
# Hetzner firewall opening 80 + 443 (configured in tofu/hetzner/main.tf).
kaneo_public_domain: ""
# Contact email for Let's Encrypt — required when any public vhost is set.
caddy_acme_email: ""

# === Kaneo MCP (bot ↔ Kaneo bridge) ===
# Populated AFTER first deploy by running scripts/pair-kaneo.py on
# the VM. The script drives Kaneo's OAuth 2.0 device-code flow
# (client_id: kaneo-mcp) and writes the session token to
# /etc/telegram-ai-agent/.env directly; copy the same value here
# so redeploys preserve it. Session bearer expires after 30 days
# — re-run the pairing script and update both .env and sops.
kaneo_mcp_url: ""
kaneo_mcp_bearer: ""

# === Content Publisher ===
# Feature: content-publish-pipeline. Operator-driven blog publishing to a
# Telegram channel via a dedicated forum topic. All 10 keys below are
# consumed by the content-publisher Ansible role and rendered into
# /etc/blogger.env on the VM. See work/content-publish-pipeline/tech-spec.md.

# Separate publisher bot from @BotFather. Operator creates the bot
# (e.g. @mnemonik_publisher_bot), then makes it an admin of the target
# Telegram channel so it can post messages. Distinct from the orchestrator
# bot (telegram_bot_token) to keep blast radius bounded — leak of this
# token grants channel-post rights only. See Decision 5, AC12.
blogger_telegram_bot_token: "YOUR_BLOGGER_BOT_TOKEN_HERE"

# Public channel handle the publisher posts to. Format: "@channelname"
# (or a -100… numeric chat_id for private channels). Default in the
# Ansible role template is "@mnemonik".
blogger_telegram_channel: "@mnemonik"

# message_thread_id of the forum topic `📝 blogger-prompts` inside the
# existing telegram_forum_chat_id supergroup. The publisher bot-handler
# filters incoming messages by this thread_id — without it the handler
# cannot route briefs (see Decision 13).
# How to obtain: create the topic in Telegram UI, then either
#   - forward a message from the topic to @RawDataBot, OR
#   - hit https://api.telegram.org/bot<TOKEN>/getUpdates
# and read `message.message_thread_id`. Stored as a string (matches
# telegram_ops_thread_id convention); "0" = "operator hasn't configured
# the topic yet" — handler stays inert.
blogger_prompts_topic_id: "0"

# Minimum score from claude-blog's analyze_blog.py for auto-approving
# a preview. Integer 0-100; recommended default 80. Below this score
# the worker still posts the preview but flags it as "low score" in
# the approval message.
publish_min_score: 80

# Minutes after a preview is sent before auto-publish kicks in (when
# PUBLISH_MODE=approval and the operator hasn't responded). Integer
# minutes; recommended default 5. Approval window — operator can /reject
# inside this window to abort.
publish_approval_timeout_min: 5

# Publishing mode: "approval" or "auto".
#   - approval: render preview, wait for operator approval (or timeout).
#   - auto:    skip preview, publish directly; operator gets a post-fact
#              receipt in the topic.
# Default "approval". See Decision 7.
publish_mode: "approval"

# Two-location integrity binding for PUBLISH_MODE=auto (Decision 7).
# When publish_mode == "auto", the worker on startup compares its env
# var PUBLISH_AUTO_MODE_TOKEN (rendered from this sops key into
# /etc/blogger.env) with the same sops key read directly. Mismatch →
# loud abort (prevents a stale /etc/blogger.env from silently keeping
# auto-mode active after the operator flipped sops back to approval).
# For PUBLISH_MODE=approval this value is unused — empty string is OK.
# Generate when enabling auto-mode:
#   openssl rand -hex 32
publish_auto_mode_token: ""

# Pinned commit SHA for mnemonik-dev/blogger (the CLI that wraps the
# publishing flow). The content-publisher role clones this exact ref;
# bumping requires an sops edit + redeploy (no silent drift). See
# Decision 11. Format: 40-char hex git SHA.
blogger_repo_ref: ""

# Pinned commit SHA for mnemonik-dev/claude-blog (skill suite + the
# analyze_blog.py scorer). Same model as blogger_repo_ref. See
# Decision 11.
claude_blog_repo_ref: ""

# HMAC key(s) for signing Telegram inline-button callback_data (the
# /approve and /reject buttons under preview messages). Worker
# verifies signatures on every callback to reject forged or replayed
# callbacks. See Decision 9.
# Formats:
#   "<current>"            single key, no rotation in flight
#   "<current>,<previous>" rotation window — worker accepts callbacks
#                          signed with either key. Used to drain old
#                          in-flight previews after a key rotation.
# Rotation procedure: (1) generate new key with `openssl rand -hex 32`,
# (2) edit sops to "<new>,<current>", (3) redeploy, (4) wait until all
# in-flight previews older than the rotation moment have been resolved
# or have timed out (approval_timeout_min × safety factor), (5) edit
# sops to "<new>" (drop trailing comma + old key), (6) redeploy.
# Generate: openssl rand -hex 32
publish_callback_hmac_secrets: ""
