[Unit]
Description=telegram-ai-agent — AI-powered Telegram bot for coding-fabric
Documentation=work/mnemonic-tg-bridge/user-spec.md
After=network-online.target tailscaled.service

Wants=network-online.target

[Service]
Type=simple
User={{ telegram_ai_agent_owner }}
Group={{ telegram_ai_agent_group }}

# Working directory and environment
WorkingDirectory={{ telegram_ai_agent_home }}
EnvironmentFile={{ telegram_ai_agent_config_dir }}/.env

# Writable HOME for child processes (claude CLI caches config/telemetry
# under $HOME/.claude). ProtectHome=true below makes the op user's real
# home inaccessible, and the default unset HOME falls back to /root which
# is unreadable to uid 1000 — claude then hangs at startup with no output.
# StateDirectory creates /var/lib/telegram-ai-agent owned by the service
# user and matches its lifecycle.
StateDirectory=telegram-ai-agent
Environment="HOME=/var/lib/telegram-ai-agent"

# Main process: run telegram-ai-agent with config
ExecStart={{ telegram_ai_agent_home }}/.venv/bin/python -m telegram_bot \
  --config {{ telegram_ai_agent_config_dir }}/config.yml

# Restart policy: on-failure with backoff
Restart={{ telegram_ai_agent_restart_policy }}
RestartSec={{ telegram_ai_agent_restart_sec }}

# Timeout for start/stop (default 90s is usually sufficient)
TimeoutStartSec=120
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
# Bot spawns claude with cwd=/home/op/work for actual coding work.
# ProtectHome=true masks /home (tmpfs over it) and BindPaths=/home/op/work
# did NOT win against the mask in our setup — asyncio.create_subprocess_exec
# kept failing with EACCES at chdir. Disable ProtectHome entirely;
# ProtectSystem=strict + the ReadWritePaths whitelist below still confine
# writes to the listed paths only. (Live drop-in proved this works.)
ProtectHome=no
PrivateTmp=true
ProtectDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true

# Whitelist of writable locations under ProtectSystem=strict.
# /home/op/work is the operator's worktree root where claude is spawned.
ReadWritePaths={{ telegram_ai_agent_home }} {{ telegram_ai_agent_config_dir }} /home/op/work

# Standard output / error logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-ai-agent

# Resource limits (optional, adjust if needed)
# LimitNOFILE=65536
# MemoryLimit=1G

[Install]
WantedBy=multi-user.target
