# infrastructure/secrets/secrets.sops.yml.template
#
# Template for encrypted secrets file. Operator populates with actual values,
# then runs bootstrap.sh to encrypt with sops + age.
#
# After encryption, this template is committed to git (for documentation).
# The ENCRYPTED version (secrets.sops.yml) is also committed (encrypted-at-rest).
# Only the age private key (~/.config/sops/age/keys.txt) must stay local.
#
# GitHub Actions decrypts at deploy time using SOPS_AGE_KEY secret.

# Hetzner Cloud API token
hcloud_token: "YOUR_HCLOUD_TOKEN_HERE"

# Tailscale OAuth credentials (for GitHub Actions ephemeral auth)
tailscale_oauth_client_id: "YOUR_TAILSCALE_OAUTH_CLIENT_ID_HERE"
tailscale_oauth_secret: "YOUR_TAILSCALE_OAUTH_SECRET_HERE"

# Tailscale auth key for VM onboarding (single-use, short-lived)
tailscale_auth_key: "tskey-auth-YOUR_AUTH_KEY_HERE"

# Vaultwarden secrets vault
vaultwarden_initial_admin_password: "YOUR_VAULTWARDEN_ADMIN_PASSWORD_HERE"
vaultwarden_admin_token: "YOUR_VAULTWARDEN_ADMIN_TOKEN_HERE"

# Telegram Bot API token and chat IDs
telegram_bot_token: "YOUR_TELEGRAM_BOT_TOKEN_HERE"
telegram_forum_chat_id: "-1001YOUR_FORUM_CHAT_ID"
telegram_ops_chat_id: "-1001YOUR_OPS_CHAT_ID"
telegram_ops_thread_id: "123456"
telegram_ai_agent_pin: "YOUR_TELEGRAM_AI_AGENT_PIN"

# Blockchain keys
solana_devnet_keypair: "YOUR_SOLANA_DEVNET_KEYPAIR_JSON_HERE"
irys_testnet_private_key: "YOUR_IRYS_TESTNET_PRIVATE_KEY_HERE"

# LLM API keys
anthropic_api_key: "sk-ant-YOUR_ANTHROPIC_API_KEY_HERE"
openai_api_key: "sk-YOUR_OPENAI_API_KEY_HERE"
deepgram_api_key: "YOUR_DEEPGRAM_API_KEY_HERE"

# GitHub deploy PAT (for recursive self-hosting)
github_deploy_pat: "ghp_YOUR_GITHUB_DEPLOY_PAT_HERE"

# Backup storage (Restic)
restic_repository: "s3:s3.example.com/bucket/fabric-backups"
restic_password: "YOUR_RESTIC_PASSWORD_HERE"

# Mnemonic attestation
mnemonic_signing_key_vault_ref: "vault://YOUR_VAULT_REFERENCE_HERE"
kaneo_api_token: "YOUR_KANEO_API_TOKEN_HERE"
ruflo_installer_sha256: "YOUR_RUFLO_INSTALLER_SHA256_HERE"
mnemonic_mcp_binary_sha256: "YOUR_MNEMONIC_MCP_BINARY_SHA256_HERE"

# Telegram AI Agent configuration (upstream)
telegram_ai_agent_repo: "https://github.com/pavel-molyanov/telegram-ai-agent.git"
telegram_ai_agent_ref: "main"
