#!/bin/bash
set -euo pipefail

# Restic backup script for mnemonic-loop coding-fabric
# Backs up critical paths to off-site repository (Hetzner Storage Box or S3)
# with retention policy enforcement via restic forget --prune
# On failure, posts alert to Telegram ops topic
#
# Environment variables (RESTIC_*, TELEGRAM_*) are loaded by systemd EnvironmentFile
# in fabric-backup.service — do NOT source /etc/restic/repo.env from bash

# Configuration
BACKUP_PATHS=(
{%- for path in restic_paths %}
  "{{ path }}"
{%- endfor %}
)

EXCLUDE_PATTERNS=(
{%- for pattern in restic_excludes %}
  "--exclude={{ pattern }}"
{%- endfor %}
)

RETRY_COUNT={{ restic_backup_retry_count }}
RETRY_DELAY={{ restic_backup_retry_delay }}

# Retention policy
KEEP_DAILY={{ restic_keep_daily }}
KEEP_WEEKLY={{ restic_keep_weekly }}
KEEP_MONTHLY={{ restic_keep_monthly }}

# Temporary log file
LOG_FILE="/tmp/restic-backup-$(date +%s).log"

# Error handler: post failure alert to Telegram
post_failure_alert() {
  local exit_code="$1"
  local error_msg="${2:-unknown error}"
  local hostname=$(hostname)
  local timestamp=$(date -Iseconds)

  # Redact sensitive paths from log output (SFTP repository URLs, full paths)
  local log_tail=$(tail -20 "${LOG_FILE}" 2>/dev/null | sed -E 's#(sftp:|s3:)[^ ]+#<redacted-repo>#g' || echo 'log file not available')

  local message="BACKUP FAILED on ${hostname}
Timestamp: ${timestamp}
Exit code: ${exit_code}
Error: ${error_msg}
Log: https://ops-dashboard/logs/fabric-backup

Last 20 lines of backup log:
---
${log_tail}
---"

  if [[ -n "${TELEGRAM_BOT_TOKEN:-}" ]] && [[ -n "${TELEGRAM_OPS_CHAT_ID:-}" ]]; then
    # Use jq to build JSON with proper escaping (prevents JSON injection)
    local json_body
    json_body=$(jq -n \
      --arg chat_id "${TELEGRAM_OPS_CHAT_ID}" \
      --arg text "${message}" \
      '{chat_id: $chat_id, text: $text, parse_mode: "MarkdownV2"}')

    # Audit Finding F-004 (T21): the bot token is composed into TG_URL inside
    # the shell so it does not appear in this script's argv as a literal Jinja
    # substitution.  curl's argv does briefly contain the URL; that exposure
    # window is mitigated by systemd User=op + service hardening on the
    # fabric-backup unit.
    local tg_url="https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage"
    curl -s -X POST "${tg_url}" \
      -H "Content-Type: application/json" \
      -d "${json_body}" > /dev/null 2>&1 || true
  fi

  exit "${exit_code}"
}

trap 'post_failure_alert $? "Script interrupted or failed"' ERR
trap 'rm -f "${LOG_FILE}"' EXIT

log_message() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "${LOG_FILE}"
}

log_message "Starting backup to ${RESTIC_REPOSITORY}"

# Perform backup with retries
attempt=1
while [[ $attempt -le $RETRY_COUNT ]]; do
  if restic backup "${BACKUP_PATHS[@]}" "${EXCLUDE_PATTERNS[@]}" >> "${LOG_FILE}" 2>&1; then
    log_message "Backup completed successfully (attempt $attempt/$RETRY_COUNT)"
    break
  else
    if [[ $attempt -lt $RETRY_COUNT ]]; then
      log_message "Backup attempt $attempt failed, retrying in ${RETRY_DELAY}s..."
      sleep "${RETRY_DELAY}"
    else
      post_failure_alert 1 "Backup failed after $RETRY_COUNT attempts"
    fi
  fi
  ((attempt++))
done

log_message "Applying retention policy: keep-daily=$KEEP_DAILY, keep-weekly=$KEEP_WEEKLY, keep-monthly=$KEEP_MONTHLY"

# Validate retention policy parameters to prevent accidental data loss
if ! [[ "$KEEP_DAILY" =~ ^[1-9][0-9]*$ ]] || ! [[ "$KEEP_WEEKLY" =~ ^[1-9][0-9]*$ ]] || ! [[ "$KEEP_MONTHLY" =~ ^[1-9][0-9]*$ ]]; then
  log_message "FATAL: Invalid retention policy values (all must be >= 1): keep-daily=$KEEP_DAILY, keep-weekly=$KEEP_WEEKLY, keep-monthly=$KEEP_MONTHLY"
  post_failure_alert 2 "Invalid retention policy configuration; refusing to prune"
fi

# Run forget with --dry-run first to audit snapshot deletion count
DRY_RUN_OUTPUT=$(restic forget --keep-daily "$KEEP_DAILY" --keep-weekly "$KEEP_WEEKLY" --keep-monthly "$KEEP_MONTHLY" --dry-run 2>&1 || true)
DELETE_COUNT=$(echo "$DRY_RUN_OUTPUT" | grep -c "remove" || echo 0)

if [[ $DELETE_COUNT -gt 50 ]]; then
  log_message "WARNING: Retention policy would delete $DELETE_COUNT snapshots (>50 threshold) — aborting prune to prevent data loss"
  post_failure_alert 3 "Retention policy would delete too many snapshots ($DELETE_COUNT); refusing to prune"
fi

if restic forget --keep-daily "$KEEP_DAILY" --keep-weekly "$KEEP_WEEKLY" --keep-monthly "$KEEP_MONTHLY" --prune >> "${LOG_FILE}" 2>&1; then
  log_message "Retention policy applied and pruned ($DELETE_COUNT snapshots deleted)"
else
  log_message "WARNING: Retention policy application failed (backup kept, but cleanup incomplete)"
fi

log_message "Backup cycle completed successfully"
exit 0
