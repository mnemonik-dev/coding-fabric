#!/bin/bash

set -euo pipefail

# post-deploy.sh
# Trigger point 5: deploy + post-deploy verification
# Invokes mnemonic_sign_memory to finalize feature attestation
# Parent: pre-deploy attestation
# Completion: final DAG node

REPO_ROOT="${REPO_ROOT:-.}"
FEATURE=""
ARTEFACT=""
ARTEFACT_REAL=""

# Source validation helper
source "$(dirname "$0")/_hook-validate.sh"

while [[ $# -gt 0 ]]; do
  case $1 in
    --feature)
      FEATURE="$2"
      shift 2
      ;;
    --artefact)
      ARTEFACT="$2"
      shift 2
      ;;
    *)
      echo "Usage: $0 --feature <name> --artefact <path>" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$FEATURE" ]] || [[ -z "$ARTEFACT" ]]; then
  echo "post-deploy.sh: FEATURE and ARTEFACT required" >&2
  exit 1
fi

# Validate inputs
if ! validate_feature "$FEATURE"; then
  exit 2
fi

if ! validate_artefact "$ARTEFACT" "$REPO_ROOT"; then
  exit 2
fi

ARTEFACT_REAL=$(readlink -f -- "$ARTEFACT")

# Anchor work directory to absolute path
WORK_DIR="/var/lib/mnemonic-mcp/features/$FEATURE"
ATTESTATIONS_FILE="$WORK_DIR/attestations.yml"
LOCK_FILE="$WORK_DIR/.attestations.lock"

# Use file locking to prevent concurrent corruption
{
  flock -x 9 || {
    echo "post-deploy.sh: failed to acquire lock" >&2
    exit 1
  }

  # Verify parent (pre-deploy attestation) exists
  if [[ ! -f "$ATTESTATIONS_FILE" ]] || ! grep -q "pre_deploy:" "$ATTESTATIONS_FILE"; then
    echo "post-deploy.sh: parent attestation (pre_deploy) not found" >&2
    exit 1
  fi

  PARENT_ID=$(grep -A1 "pre_deploy:" "$ATTESTATIONS_FILE" | grep "attestation_id:" | awk '{print $NF}')
  if [[ ! "$PARENT_ID" =~ ^[a-f0-9-]{36}$ ]]; then
    echo "post-deploy.sh: failed to extract valid parent attestation_id" >&2
    exit 1
  fi

  # Invoke mnemonic_sign_memory with parent reference (final node)
  if ! ATTESTATION_OUTPUT=$(mnemonic_sign_memory \
    --content "deploy + post-deploy verified: $FEATURE" \
    --parent "$PARENT_ID" \
    --tags "post-deploy" "$FEATURE" 2>/var/log/mnemonic-mcp/hook-sign-err.log); then
    echo "post-deploy.sh: mnemonic_sign_memory failed" >&2
    exit 1
  fi

  # Extract attestation_id from stdout only (strict validation)
  ATTESTATION_ID=$(echo "$ATTESTATION_OUTPUT" | grep -oP '^\s*attestation_id[=:]?\s*\K[a-f0-9-]{36}$' 2>/dev/null || echo "")
  if [[ ! "$ATTESTATION_ID" =~ ^[a-f0-9-]{36}$ ]]; then
    echo "post-deploy.sh: failed to extract valid attestation_id" >&2
    exit 1
  fi

  # Write attestation with safe YAML (final node)
  python3 -c "
import yaml

data = {
    'post_deploy': {
        'attestation_id': '$ATTESTATION_ID',
        'parent_id': '$PARENT_ID',
        'timestamp': '$(date -u +%Y-%m-%dT%H:%M:%SZ)',
        'artefact': '$ARTEFACT_REAL'
    }
}

with open('$ATTESTATIONS_FILE', 'a') as f:
    yaml.safe_dump(data, f, default_flow_style=False)
" || {
    echo "post-deploy.sh: failed to write attestations.yml" >&2
    exit 1
  }

  chmod 0640 "$ATTESTATIONS_FILE" 2>/dev/null || true

} 9>"$LOCK_FILE"

echo "post-deploy.sh: attestation created: $ATTESTATION_ID (parent: $PARENT_ID, DAG complete)"
exit 0
