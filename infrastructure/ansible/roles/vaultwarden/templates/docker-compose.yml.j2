services:
  # 'version' key removed — obsolete in modern compose, was triggering
  # warnings in run 26187939733 output.
  vaultwarden:
    image: {{ vaultwarden_image }}
    container_name: vaultwarden-vaultwarden-1
    restart: unless-stopped
    env_file:
      - .env
    environment:
      DOMAIN: "https://{{ vaultwarden_tailnet_domain }}"
      LOG_LEVEL: "info"
      EXTENDED_LOGGING: "true"
      LOG_FILE: "/data/vaultwarden.log"
      SHOW_PASSWORD_HINT: "false"
      INVITATIONS_ALLOWED: "true"
      INVITATION_ORG_NAME: "Mnemonic Fabric"
    volumes:
      - ./data:/data
    networks:
      - vaultwarden
    # Healthcheck removed — the vaultwarden image (debian:bookworm-slim
    # base) ships neither curl nor wget; the original
    # `curl -f http://localhost:80/api/health` check failed immediately,
    # Docker marked the container unhealthy, and caddy's `service_healthy`
    # gate then timed out the whole stack (run 26187939733). The Ansible
    # role's "Wait for Vaultwarden API to be healthy" task performs an
    # external probe from the runner — that is the authoritative health
    # gate; an in-container check would be redundant.
    # NOTE: vaultwarden intentionally has NO depends_on.

  caddy:
    image: {{ vaultwarden_caddy_image }}
    container_name: vaultwarden-caddy-1
    restart: unless-stopped
    ports:
      - "{{ tailscale_ip }}:{{ vaultwarden_https_port }}:8443/tcp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./caddy_data:/data
      - ./caddy_config:/config
      # conf.d may be empty but the directory MUST exist — Caddy's
      # `import /etc/caddy/conf.d/*.conf` aborts startup otherwise.
      - ./caddy_conf_d:/etc/caddy/conf.d:ro
    networks:
      - vaultwarden
    # caddy depends_on vaultwarden with service_started (default), NOT
    # service_healthy — vaultwarden has no in-container healthcheck (see
    # note above). caddy will retry upstream connections naturally if
    # vaultwarden is still booting.
    depends_on:
      - vaultwarden

networks:
  vaultwarden:
    driver: bridge

volumes:
  caddy_data:
    driver: local
  caddy_config:
    driver: local
