services:
  postgres:
    image: postgres:16-alpine
    container_name: kaneo-postgres-1
    restart: unless-stopped
    environment:
      POSTGRES_DB: "{{ kaneo_postgres_db }}"
      POSTGRES_USER: "{{ kaneo_postgres_user }}"
      POSTGRES_PASSWORD: "{{ kaneo_postgres_password }}"
    volumes:
      - {{ kaneo_data_dir }}/postgres:/var/lib/postgresql/data
    networks:
      - kaneo
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ kaneo_postgres_user }} -d {{ kaneo_postgres_db }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  kaneo:
    image: {{ kaneo_image }}
    container_name: kaneo-kaneo-1
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      # Database (matches upstream compose.yml: derived DATABASE_URL when
      # POSTGRES_PASSWORD or explicit host/port is set).
      POSTGRES_DB: "{{ kaneo_postgres_db }}"
      POSTGRES_USER: "{{ kaneo_postgres_user }}"
      POSTGRES_PASSWORD: "{{ kaneo_postgres_password }}"
      POSTGRES_HOST: postgres
      POSTGRES_PORT: "5432"
      # JWT signing key for auth sessions (min 32 chars per upstream docs).
      # Without this a random secret is generated each start and sessions
      # don't survive container restart.
      AUTH_SECRET: "{{ kaneo_auth_secret }}"
      # Client + API URLs (used in OAuth redirect URIs and CORS). The
      # explicit :8443 matches the Caddy vhost binding — without it the
      # device-code verification_uri Kaneo prints to operators omits
      # the port, the browser hits the bare https:// (port 443) which
      # Caddy doesn't listen on, and the page fails to load.
      KANEO_CLIENT_URL: "https://{{ kaneo_tailnet_domain }}:{{ vaultwarden_https_port | default(8443) }}"
      KANEO_API_URL: "https://{{ kaneo_tailnet_domain }}:{{ vaultwarden_https_port | default(8443) }}/api"
    networks:
      # `kaneo` (internal) — for Kaneo ↔ Postgres only.
      kaneo: {}
      # `vaultwarden_vaultwarden` (external — created by the vaultwarden
      # role) — so Caddy can route the tailnet vhost to this container.
      # Without joining this network, Caddy fails with "kaneo: no such
      # host" on the reverse-proxy directive.
      vaultwarden_vaultwarden:
        aliases:
          - kaneo
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:{{ kaneo_http_port }}/api/health"]
      interval: 30s
      timeout: 5s
      start_period: 60s
      retries: 3
    expose:
      - "{{ kaneo_http_port }}"

networks:
  kaneo:
    name: kaneo
    driver: bridge
  vaultwarden_vaultwarden:
    external: true
