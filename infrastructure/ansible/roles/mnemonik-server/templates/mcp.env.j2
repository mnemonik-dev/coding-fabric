# Mnemonic MCP runtime env — rendered by the mnemonik-server role.
# DO NOT edit on the box; edit templates/mcp.env.j2. Mirrors the contract in
# mnemonik-xyz/monorepo mcp/deploy/compose.env.example, minus the nginx/certbot
# TLS knobs (Caddy owns TLS here).

# Topology: co-located ollama on the internal network.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL={{ mnemonik_ollama_model }}
LLM_PROVIDER=ollama
LLM_API_URL=http://ollama:11434
LLM_MODEL={{ mnemonik_ollama_model }}

# Identity: images before monorepo e20ccea read MNEMONIC_CONFIG_DIR/identity.json.
# Newer images read MNEMONIC_KEYPAIR_PATH, and the image default is
# /keypair/id.json. Pin both to identity.json so an image bump keeps the same
# signer instead of switching to a legacy id.json file.
MNEMONIC_CONFIG_DIR=/keypair
MNEMONIC_KEYPAIR_PATH=/keypair/identity.json

# Server runtime.
STORAGE_MODE={{ mnemonik_mcp_storage_mode }}
EMBED_PROVIDER={{ mnemonik_mcp_embed_provider }}
TURBO_BITS={{ mnemonik_mcp_turbo_bits }}
PAYMENT_MODE={{ mnemonik_mcp_payment_mode }}
RUST_LOG={{ mnemonik_mcp_rust_log }}

# Universal Paywall. Inert unless PAYMENT_MODE=universal; the role validates
# the full configuration before startup when enabled.
UNIVERSAL_PAYWALL_URL={{ mnemonik_universal_paywall_url | default('') }}
UNIVERSAL_PAYWALL_API_KEY={{ mnemonik_universal_paywall_api_key | default('') }}
UNIVERSAL_PAYWALL_PAYMENT_URL={{ mnemonik_universal_paywall_payment_url }}
UNIVERSAL_PAYWALL_NETWORK={{ mnemonik_universal_paywall_network }}
UNIVERSAL_PAYWALL_ASSET={{ mnemonik_universal_paywall_asset }}
UNIVERSAL_PAYWALL_PAY_TO={{ mnemonik_universal_paywall_pay_to }}
UNIVERSAL_PAYWALL_SESSION_CAP_MICRO_USDC={{ mnemonik_universal_paywall_session_cap_micro_usdc }}
UNIVERSAL_PAYWALL_SESSION_MAX_PER_ANCHOR_MICRO_USDC={{ mnemonik_universal_paywall_session_max_per_anchor_micro_usdc }}
UNIVERSAL_PAYWALL_SESSION_VALID_FOR_SECS={{ mnemonik_universal_paywall_session_valid_for_secs }}

# fastembed model cache lives on the persistent volume (bind-mounted to
# /data in the container). Without this override the binary may try to
# download models to a per-user cache or fail to find them after a VM
# rebuild, which surfaces as "No embedding provider available".
FASTEMBED_CACHE_DIR={{ mnemonik_mcp_fastembed_cache_dir }}

# Public origin advertised in OAuth metadata + challenge envelopes (RFC 8707
# origin check). MUST match the hostname external clients connect to.
MCP_PUBLIC_BASE_URL={{ mnemonik_mcp_public_base_url }}

# Hosted-mode secrets (from sops; generate once, keep stable across deploys).
MCP_JWT_SECRET={{ mnemonik_mcp_jwt_secret }}
MCP_REFRESH_SALT={{ mnemonik_mcp_refresh_salt }}

# Chain-backed traction stats (required by server images >= #194).
# Safe defaults point to a public RPC and an empty watch wallet list.
CHAIN_STATS_WALLETS={{ mnemonik_chain_stats_wallets | default('') }}
SOLANA_RPC_URL={{ mnemonik_solana_rpc_url | default('https://api.mainnet-beta.solana.com') }}
ARWEAVE_URL={{ mnemonik_arweave_url | default('https://gateway.irys.xyz') }}
CHAIN_STATS_GRAPHQL_URL={{ mnemonik_chain_stats_graphql_url | default('https://arweave.net/graphql') }}
CHAIN_STATS_GATEWAY_URL={{ mnemonik_chain_stats_gateway_url | default('https://gateway.irys.xyz') }}
