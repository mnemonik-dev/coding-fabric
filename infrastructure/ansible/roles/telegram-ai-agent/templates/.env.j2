# telegram-ai-agent environment configuration
# Generated by Ansible role: telegram-ai-agent (T09)
# Mode: 0600 (secrets — owner op only)

# Telegram Bot Token (from sops)
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}

# Operator allowlist — Telegram user IDs permitted to talk to this bot.
# The bot's AuthMiddleware rejects every other user with
# `Ignored message from unauthorized user`. Empty list means NO ONE is
# allowed (bot will reject every message including the operator's).
# Pydantic-settings parses JSON list literals from env vars.
{%- set _ids = telegram_ai_agent_allowed_user_ids | default([]) %}
ALLOWED_USER_IDS=[{{ _ids | map('int') | join(',') }}]

# workspace-manager resolver URL for cwd:"DYNAMIC" sentinel (T08 dependency)
TELEGRAM_AI_AGENT_CWD_RESOLVER_URL=http://{{ tailscale_ip }}:8080

# Claude Code OAuth token — primary auth path (subscription, sk-ant-oat01-...).
# Generated locally via `claude setup-token` on operator laptop; minimal
# scope (user:inference) means leak risk is limited to quota burn.
{% if claude_code_oauth_token is defined and claude_code_oauth_token | length > 0 %}
CLAUDE_CODE_OAUTH_TOKEN={{ claude_code_oauth_token }}
{% endif %}

# Anthropic API Key — fallback (pay-per-token). Activated automatically by
# claude CLI if OAuth token auth fails (revoked / expired). Leave empty to
# disable fallback and surface auth failures loudly instead.
{% if anthropic_api_key is defined and anthropic_api_key | length > 0 %}
ANTHROPIC_API_KEY={{ anthropic_api_key }}
{% endif %}

# OpenAI API Key — required only if demo-client topic uses Codex
{% if openai_api_key is defined and openai_api_key | length > 0 %}
OPENAI_API_KEY={{ openai_api_key }}
{% endif %}

# Deepgram API Key — required only if voice transcription is enabled
{% if deepgram_api_key is defined and deepgram_api_key | length > 0 %}
DEEPGRAM_API_KEY={{ deepgram_api_key }}
{% endif %}

# Logging
LOG_LEVEL={{ telegram_ai_agent_log_level | default('info') }}

# Kaneo MCP server — populated AFTER first deploy by running the
# operator pairing script (scripts/pair-kaneo.py). Bot auto-injects
# the kaneo MCP server into every claude/codex session when both
# vars are set; leaves the runtime config untouched otherwise.
KANEO_MCP_URL={{ kaneo_mcp_url | default("") }}
KANEO_MCP_BEARER={{ kaneo_mcp_bearer | default("") }}

# GitHub MCP — operator can ask claude to create repos / open PRs from
# Telegram. Source from sops.github_deploy_pat (existing key; ensure
# it has 'repo' scope). Empty = MCP server skipped, no behavior change.
GITHUB_PERSONAL_ACCESS_TOKEN={{ github_personal_access_token | default('') }}

# Bot's default cwd for chats with no per-topic binding. Path created
# by an Ansible file: task; see role's tasks/main.yml.
DEFAULT_CWD={{ telegram_ai_agent_default_cwd | default('/home/op/work') }}
