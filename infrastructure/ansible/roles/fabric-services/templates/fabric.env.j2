# fabric.env — environment variables for fabric services
# Sourced by systemd units and local shell scripts
# Contains paths, API endpoints, and non-secret configuration

# Fabric installation
FABRIC_ROOT={{ fabric_target_dir }}
PYTHONPATH={{ fabric_target_dir }}:$PYTHONPATH

# Workspace manager API
WORKSPACE_MANAGER_HOST={{ workspace_manager_listen_ip }}
WORKSPACE_MANAGER_PORT={{ workspace_manager_listen_port }}
WORKSPACE_MANAGER_URL=http://{{ workspace_manager_listen_ip }}:{{ workspace_manager_listen_port }}
WORKSPACE_MANAGER_CAPACITY={{ workspace_manager_capacity }}

# Mnemonic framework
MNEMONIC_MCP_SOCKET=/run/mnemonic-mcp.sock
MNEMONIC_MODE=local
MEMORY_NAMESPACE=mnemonic-core

# Telegram integration
TELEGRAM_AI_AGENT_WORKSPACE_MANAGER_URL=http://{{ workspace_manager_listen_ip }}:{{ workspace_manager_listen_port }}
TELEGRAM_AI_AGENT_CWD_RESOLVER_URL=http://{{ ansible_default_ipv4.address | default('127.0.0.1') }}:{{ workspace_manager_listen_port }}

# Logging
FABRIC_LOG_DIR={{ fabric_target_dir }}/logs
FABRIC_LOG_LEVEL=INFO
SANITIZER_ENABLED=true

# Watchdog
FABRIC_WATCHDOG_INTERVAL=300
FABRIC_WATCHDOG_ALERT_CLASSES=9

# Caching
SCCACHE_ENABLED=true
SCCACHE_DIR=/tmp/sccache

# Development
DEBUG=false
