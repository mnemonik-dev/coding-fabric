#!/usr/bin/env python3
"""Fake anvil (molecule only): logs argv and holds the port open."""
import socket
import sys

sys.path.insert(0, "/usr/local/lib/wc-fake")
from fakelib import log  # noqa: E402

argv = sys.argv[1:]
log("anvil", argv)
port = int(argv[argv.index("--port") + 1]) if "--port" in argv else 8545
srv = socket.socket()
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(("127.0.0.1", port))
srv.listen(8)
while True:
    conn, _ = srv.accept()
    conn.close()
