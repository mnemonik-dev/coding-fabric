# Symphony secrets EnvironmentFile.
# Rendered by the fabric-services role at deploy time from sops vars.
# Mode 0640 root:root — only root + the workspace-manager service can read.
# DO NOT edit by hand on the VM; changes get overwritten on next deploy.
# To rotate any value: edit infrastructure/secrets/secrets.sops.yml
# (via `sops`) and redeploy.

# Multi-PAT registry for Symphony's per-project GitHub auth. JSON map of
# {name: PAT}. Operator selects which name via `pat: <name>` in the
# Kaneo project description.
GITHUB_PATS={{ github_pats_json }}

# Telegram-side mirror — Symphony's _notify_topic posts dispatch start
# + completion to the per-task Telegram topic alongside Kaneo comments.
TELEGRAM_FORUM_CHAT_ID={{ telegram_forum_chat_id | default('') }}
BOT_TOKEN={{ telegram_bot_token | default('') }}

# Kaneo session bearer — same token paired into the bot via
# scripts/pair-kaneo.py; Symphony uses it for the read-mostly REST
# calls (list active tickets, read project description, post comments,
# transition status).
KANEO_MCP_BEARER={{ kaneo_mcp_bearer | default('') }}

{% if symphony_state_dir | default('') | length > 0 %}
# Mutable Symphony state on the persistent volume: which ticket stages already
# ran (run ledger) and the runtime stage -> engine/model routing table.
SYMPHONY_LEDGER_FILE={{ symphony_state_dir }}/run-ledger.json
SYMPHONY_ROUTING_FILE={{ symphony_state_dir }}/routing.json
{% endif %}
{% if symphony_mcp_config_path | default('') | length > 0 %}
# MCP servers (kaneo, bot) handed to claude runs via --mcp-config.
SYMPHONY_MCP_CONFIG={{ symphony_mcp_config_path }}
{% endif %}
