# Terraform / OpenTofu working directory — contains downloaded provider plugins.
# Never commit; regenerated by `tofu init`.
.terraform/

# State files — contain resource IDs and may contain sensitive attribute values.
# Local state is acceptable for Task 01; remote encrypted state is wired in Task 24.
*.tfstate
*.tfstate.backup

# OpenTofu crash log
crash.log

# Variable override files — may contain sensitive values.
*.tfvars
*.tfvars.json
# Exception: example / template var files are safe to commit.
!*.tfvars.example

# Terraform plan files — binary; contain serialized sensitive values.
*.tfplan

# OpenTofu lock file: .terraform.lock.hcl is the standard lock file name used
# by both Terraform and OpenTofu (OpenTofu continues to use this filename for
# compatibility). Commit the lock file to pin provider checksums.
# Do NOT ignore it — leave it tracked in git.
# .terraform.lock.hcl   <-- intentionally NOT listed here

# macOS noise
.DS_Store
