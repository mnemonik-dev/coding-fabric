# Vaultwarden environment file
# This file is templated and contains sensitive data; mode 0600

DOMAIN=https://{{ vaultwarden_tailnet_domain }}
LOG_LEVEL=info
EXTENDED_LOGGING=true
LOG_FILE=/data/vaultwarden.log
SHOW_PASSWORD_HINT=false
INVITATIONS_ALLOWED=true
INVITATION_ORG_NAME=Mnemonic Fabric

# Admin token for API access (from sops)
ADMIN_TOKEN="{{ vaultwarden_admin_token | quote }}"

# Security settings
REVEAL_DOMAIN=true
SENDS_ALLOWED=true
EMERGENCY_ACCESS_ALLOWED=true
ORG_GROUPS_ENABLED=true
