# Restic backup repository configuration
# Loaded via systemd EnvironmentFile directive in fabric-backup.service
# Do NOT source this file from bash — systemd's EnvironmentFile is safer (no shell metachar risk)
# Mode 0600 — do not commit to version control

RESTIC_REPOSITORY={{ restic_repository | quote }}
RESTIC_PASSWORD={{ restic_password | quote }}

{% if restic_s3_access_key %}
RESTIC_S3_ACCESS_KEY={{ restic_s3_access_key | quote }}
{% endif %}

{% if restic_s3_secret_key %}
RESTIC_S3_SECRET_KEY={{ restic_s3_secret_key | quote }}
{% endif %}
