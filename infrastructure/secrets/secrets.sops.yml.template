# infrastructure/secrets/secrets.sops.yml.template
#
# Template for encrypted secrets file. Operator workflow:
#   cp infrastructure/secrets/secrets.sops.yml.template \
#      infrastructure/secrets/secrets.sops.yml
#   sops -e -i infrastructure/secrets/secrets.sops.yml
#   sops infrastructure/secrets/secrets.sops.yml      # opens $EDITOR; fill values; save -> auto-encrypts
#
# After encryption, secrets.sops.yml is committed to git (encrypted-at-rest,
# safe in a public repo). Only the age private key (in
# ~/.config/sops/age/keys.txt locally and SOPS_AGE_KEY GitHub Actions secret)
# must stay private.
#
# Last cleaned: 2026-05-20 — added claude_credentials (subscription auth);
# removed solana_devnet_keypair + irys_testnet_private_key (mnemonic-mcp
# descoped, see decisions.md Round 2).

# === Hetzner Cloud ===
# API token (R/W). Mirrored in GH secret HCLOUD_TOKEN.
hcloud_token: "YOUR_HCLOUD_TOKEN_HERE"

# === Tailscale ===
# Auth key — used by `tailscale` Ansible role to join VM to your tailnet.
# Generate at: https://login.tailscale.com/admin/settings/keys
# Settings: reusable, ephemeral, pre-approved, tag=tag:fabric, TTL 90d.
# (CI uses separate OAuth client + secret in GH Actions secrets, not this.)
tailscale_auth_key: "tskey-auth-YOUR_AUTH_KEY_HERE"

# === Vaultwarden ===
# Initial admin password — for first login at https://vault.mnemonic-fabric.ts/admin
#   openssl rand -base64 32
vaultwarden_initial_admin_password: "YOUR_LONG_RANDOM_PASSWORD_HERE"
# Admin API token — long random string used by `/admin` endpoint.
#   openssl rand -hex 32
vaultwarden_admin_token: "YOUR_LONG_RANDOM_ADMIN_TOKEN_HERE"

# === Telegram ===
# Bot token from @BotFather. Mirrored in GH secret TELEGRAM_BOT_TOKEN
# for early CI alerts (before Ansible loads sops).
telegram_bot_token: "YOUR_TELEGRAM_BOT_TOKEN_HERE"
# Supergroup forum chat_id from @RawDataBot. Mirrored in GH secret.
telegram_forum_chat_id: "-1001YOUR_FORUM_CHAT_ID"
# Optional. If pre-created 'ops' topic via Telegram UI and want CI alerts
# routed there before telegram-init role auto-creates topics, set thread_id.
# Otherwise leave "0" — Ansible discovers + populates inventory at deploy time.
telegram_ops_thread_id: "0"

# === Anthropic — Claude (subscription preferred via OAuth, API key fallback) ===
# Subscription auth: long-lived OAuth token from `claude setup-token`.
# Generate on laptop where you're logged into Claude Pro/Max:
#   claude setup-token  →  browser OAuth → terminal prints token ONCE
# Format: sk-ant-oat01-<long-base64>. Scope: user:inference only (can't
# read account info or modify subscription — minimal blast radius if leaked).
# Refresh: re-run setup-token quarterly (tokens last 6-12mo) and re-encrypt.
claude_code_oauth_token: "sk-ant-oat01-YOUR_OAUTH_TOKEN_HERE"

# Optional fallback — pay-per-token API mode. Leave empty to disable fallback.
# Activated if OAuth token auth fails (e.g. token revoked / expired).
# Note: per-token API mode bypasses subscription quota → real $ cost.
anthropic_api_key: ""

# === OpenAI — Codex (optional, only for demo-client topic) ===
# Leave empty to disable demo-client engine; topic will be inactive.
openai_api_key: ""

# === Deepgram — voice transcription (optional) ===
# Leave empty to disable voice-message transcription in topics.
deepgram_api_key: ""

# === GitHub ===
# Fine-grained PAT for recursive self-hosting via mnemonic-loop merges.
# Scopes: contents:R/W on 6 mnemonic-* repos + mnemonic-loop, issues:R/W,
# pull-requests:R/W, workflows:R/W.
# https://github.com/settings/personal-access-tokens/new
github_deploy_pat: "github_pat_YOUR_FINE_GRAINED_PAT_HERE"

# === Restic backups ===
# Off-site repo URL. Hetzner Storage Box (SFTP) or any S3-compatible.
# Examples:
#   sftp:u12345@u12345.your-storagebox.de:/restic
#   s3:s3.amazonaws.com/your-bucket/coding-fabric
restic_repository: "sftp:USER@HOST:/restic"
# Strong random — encrypts the backup repo itself.
# LOSS = backups unrecoverable. Store in password manager AND paper backup.
#   openssl rand -base64 48
restic_password: "YOUR_LONG_RANDOM_RESTIC_PASSWORD_HERE"

# === Kaneo ===
# Current upstream uses Postgres + AUTH_SECRET (no static API token).
# Both required by the role; generate before first deploy:
#   openssl rand -hex 32   # AUTH_SECRET (JWT signing, >= 32 chars)
#   openssl rand -base64 24  # Postgres password (any length >= 12)
kaneo_auth_secret: "YOUR_HEX_32_BYTES_AUTH_SECRET_HERE"
kaneo_postgres_password: "YOUR_POSTGRES_PASSWORD_HERE"

# === Kaneo MCP (bot ↔ Kaneo bridge) ===
# Populated AFTER first deploy by running scripts/pair-kaneo.py on
# the VM. The script drives Kaneo's OAuth 2.0 device-code flow
# (client_id: kaneo-mcp) and writes the session token to
# /etc/telegram-ai-agent/.env directly; copy the same value here
# so redeploys preserve it. Session bearer expires after 30 days
# — re-run the pairing script and update both .env and sops.
kaneo_mcp_url: ""
kaneo_mcp_bearer: ""
