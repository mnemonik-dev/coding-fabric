---
# molyanov-mnemonic-hooks.yml
# Registers 5 mnemonic MCP trigger-point hooks with molyanov success paths
# Each hook is invoked at successful completion of corresponding phase

hooks:
  user-spec-approved:
    phase: user-spec
    command: "{{ mnemonic_mcp_hooks_dir }}/user-spec.sh"
    args:
      - "--feature={{ feature_name }}"
      - "--artefact={{ spec_path }}/user-spec.md"
    on_success: true
    fail_mode: exit

  tech-spec-approved:
    phase: tech-spec
    command: "{{ mnemonic_mcp_hooks_dir }}/tech-spec.sh"
    args:
      - "--feature={{ feature_name }}"
      - "--artefact={{ spec_path }}/tech-spec.md"
    on_success: true
    fail_mode: exit

  tasks-completed:
    phase: tasks
    command: "{{ mnemonic_mcp_hooks_dir }}/task-complete.sh"
    args:
      - "--feature={{ feature_name }}"
      - "--artefact={{ spec_path }}/tasks"
    on_success: true
    fail_mode: exit

  pre-deploy-qa:
    phase: pre-deploy-qa
    command: "{{ mnemonic_mcp_hooks_dir }}/pre-deploy.sh"
    args:
      - "--feature={{ feature_name }}"
      - "--artefact={{ spec_path }}/pre-deploy-report.md"
    on_success: true
    fail_mode: exit

  post-deploy-verification:
    phase: post-deploy
    command: "{{ mnemonic_mcp_hooks_dir }}/post-deploy.sh"
    args:
      - "--feature={{ feature_name }}"
      - "--artefact={{ spec_path }}/post-deploy-report.md"
    on_success: true
    fail_mode: exit
