---
# Mnemonic MCP Server Configuration

# Bind address and port
server:
  bind: "{{ mnemonic_mcp_bind_host }}:{{ mnemonic_mcp_bind_port }}"
  timeout: 30

# Operation mode: "local" (default) or "full"
# "local": signs in-process, no network calls
# "full": anchors attestations to Solana devnet and Arweave testnet (requires credentials)
mode: "{{ mnemonic_mcp_mode }}"

# Credential paths (only used in "full" mode)
credentials:
  solana_rpc: "{{ solana_devnet_rpc_url }}"
  arweave_endpoint: "{{ arweave_testnet_url }}"

# Logging
logging:
  level: "info"
  format: "json"

# DAG construction
dag:
  namespace: "mnemonic-protocol"
  store: "/var/lib/mnemonic-mcp/dag.db"
