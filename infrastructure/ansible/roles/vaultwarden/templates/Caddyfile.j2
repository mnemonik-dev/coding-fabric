{
  log {
    level {{ vaultwarden_caddy_log_level }}
  }
  storage file_system /data/caddy
}

{{ vaultwarden_tailnet_domain }}:8443 {
  tls internal

  reverse_proxy vaultwarden:80 {
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-Proto https
    # X-Forwarded-For and X-Forwarded-Host are added by caddy by default —
    # explicit header_up rules emit "unnecessary" warnings and previously
    # masked the real config error below.

    # Active health check. NOTE: Caddy v2 has NO `health <upstream>`
    # directive — that line caused config parse failure ("unrecognized
    # subdirective health, at /etc/caddy/Caddyfile:18") and caddy restart-
    # looped (run 26205334908). The supported directives are health_uri,
    # health_interval, health_timeout, health_status.
    health_uri /alive
    health_interval 10s
    health_timeout 5s
  }

  # Disable client body size limit for Vaultwarden attachments
  request_body /

  # Add HSTS header for tailnet domain
  header Strict-Transport-Security "max-age=31536000; includeSubDomains"
  header X-Content-Type-Options "nosniff"
  header X-Frame-Options "SAMEORIGIN"
  header X-XSS-Protection "1; mode=block"
  header Referrer-Policy "same-origin"

  log {
    level {{ vaultwarden_caddy_log_level }}
    output stdout
    format console
  }
}

127.0.0.1:2019 {
  metrics
}

# Optional: snippets injected by other roles (kaneo, future apps).
# Wildcard import on a missing directory makes caddy abort startup;
# the path is mounted from /opt/vaultwarden/caddy_conf_d (created below).
# That directory may be empty — caddy treats no matches as OK.
import /etc/caddy/conf.d/*.conf
