[Unit]
Description=Mnemonik MCP Local Server (stdio transport)
Documentation=https://github.com/mnemonik-xyz/mcp
Wants=network-online.target
After=network-online.target
PartOf=multi-user.target

[Service]
Type=simple
User={{ mnemonic_mcp_service_user }}
Group={{ mnemonic_mcp_service_group }}
WorkingDirectory={{ mnemonik_mcp_install_dir }}
ExecStart={{ mnemonic_mcp_binary }} mcp-stdio

Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/var/lib/mnemonic-mcp"

Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ mnemonik_mcp_install_dir }} /var/lib/mnemonic-mcp

CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
UMask=0077
PrivateDevices=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mnemonic-mcp

[Install]
WantedBy=multi-user.target
