# telegram-ai-agent configuration
# Generated by Ansible role: telegram-ai-agent (T09)
# Source: infrastructure/ansible/roles/telegram-ai-agent/templates/config.yml.j2

topics:
{%- for topic_name, topic_config in telegram_ai_agent_topics_with_ids.items() %}
  {{ topic_name }}:
    chat_id: {{ topic_config.chat_id }}
    thread_id: {{ topic_config.thread_id }}
    engine: {{ topic_config.engine }}
    cwd: "{{ topic_config.cwd }}"
    mode: {{ topic_config.mode }}
    exec_mode: {{ topic_config.exec_mode }}
    stream_mode: {{ topic_config.stream_mode }}
    {%- if topic_config.engine == "claude" %}
    model: claude-opus-4-1
    {%- elif topic_config.engine == "codex" %}
    model: codex-latest
    {%- endif %}
{%- endfor %}

# Per-topic ruflo toggles (autopilot/aidefence/rag_memory/MNEMONIC_MODE) and
# memory namespaces were removed 2026-05-20 alongside the ruflo role drop.
# Only the engine + cwd:DYNAMIC + upstream-required fields remain.

# Logging configuration
logging:
  level: "{{ telegram_ai_agent_log_level | default('info') }}"
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
