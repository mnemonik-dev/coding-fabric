# Restic backup repository configuration
# Sourced by fabric-backup.sh and backup-verify.sh
# Mode 0600 — do not commit to version control

export RESTIC_REPOSITORY="{{ restic_repository }}"
export RESTIC_PASSWORD="{{ restic_password }}"

{% if restic_s3_access_key %}
export RESTIC_S3_ACCESS_KEY="{{ restic_s3_access_key }}"
{% endif %}

{% if restic_s3_secret_key %}
export RESTIC_S3_SECRET_KEY="{{ restic_s3_secret_key }}"
{% endif %}

# Telegram bot credentials for failure alerts
export TELEGRAM_BOT_TOKEN="{{ telegram_bot_token }}"
export TELEGRAM_OPS_CHAT_ID="{{ telegram_ops_chat_id }}"
