# ruflo integration: molyanov pk-guard hook
# Cross-role dependency: molyanov role installs the hook; ruflo role loads this config
# Rendered by Ansible role molyanov (Task 11); loaded by ruflo role (Task 10)

hooks:
  pre_write:
    - name: molyanov-pk-guard
      path: "{{ molyanov_operator_home }}/.fabric/molyanov/hooks/pk-guard.sh"
      enabled: true
      scope: "project-knowledge-protection"
      description: "Reject writes to .claude/skills/project-knowledge/references/ in RUFLO_SESSION context"
      env_vars:
        - RUFLO_SESSION
        - TELEGRAM_BOT_TOKEN
        - TELEGRAM_OPS_TOPIC
      skip_on_missing: false
