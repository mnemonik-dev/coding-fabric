# telegram-ai-agent environment configuration
# Generated by Ansible role: telegram-ai-agent (T09)
# Mode: 0600 (secrets — owner op only)

# Required: Telegram Bot Token (from sops)
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}

# Required: workspace-manager resolver URL for cwd:"DYNAMIC" sentinel (T08 dependency)
TELEGRAM_AI_AGENT_CWD_RESOLVER_URL=http://{{ tailscale_ip }}:8080

# Required: Anthropic API Key (Claude engines — from sops)
ANTHROPIC_API_KEY={{ anthropic_api_key }}

# Optional: OpenAI API Key (fallback, from sops)
{%- if openai_api_key is defined and openai_api_key | length > 0 %}
OPENAI_API_KEY={{ openai_api_key }}
{%- endif %}

# Optional: Deepgram API Key for voice transcription (from sops)
{%- if deepgram_api_key is defined and deepgram_api_key | length > 0 %}
DEEPGRAM_API_KEY={{ deepgram_api_key }}
{%- endif %}

# Logging configuration
LOG_LEVEL={{ telegram_ai_agent_log_level | default('info') }}

# Feature flags (match config.yml)
# Feature toggles are managed in config.yml per-topic; these are global defaults
ENABLE_RAG_MEMORY=true
ENABLE_AIDEFENCE=true
