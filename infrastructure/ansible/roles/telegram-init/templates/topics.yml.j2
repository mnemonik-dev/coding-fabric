---
# Telegram Forum Topics Inventory
# Auto-generated by telegram-init role
# Source of truth: name → message_thread_id mapping
# DO NOT EDIT MANUALLY — role will overwrite on re-run if mapping changes

telegram_topics:
{% for topic_name, thread_id in topics_mapping.items() | sort %}
  {{ topic_name }}: {{ thread_id }}
{% endfor %}

# Topic references for downstream roles (mnemonic-tg-bridge, fabric-watchdog)
# Example usage in playbooks:
#   message_thread_id: "{{ lookup('file', playbook_dir + '/inventory/telegram-topics.yml') | from_yaml | .telegram_topics.ops }}"

canonical_topics:
  core:
    name: core
    repository: mnemonic-core
    description: Core protocol development
  mcp:
    name: mcp
    repository: mnemonic-mcp
    description: Model Context Protocol integration
  wasm:
    name: wasm
    repository: mnemonic-wasm
    description: WASM bindings and compilation
  demo-client:
    name: demo-client
    repository: mnemonic-demo-client
    description: Demo client and UI
  docs:
    name: docs
    repository: mnemonic-docs
    description: Documentation and guides
  loop:
    name: loop
    repository: mnemonic-loop
    description: Coding fabric infrastructure
  protocol-qa:
    name: protocol-qa
    repository: mnemonic-qa
    description: Protocol testing and validation
  ops:
    name: ops
    repository: fabric-ops
    description: Operational alerts and commands
