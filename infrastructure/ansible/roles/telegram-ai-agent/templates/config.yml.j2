# telegram-ai-agent configuration
# Generated by Ansible role: telegram-ai-agent (T09)
# Source: infrastructure/ansible/roles/telegram-ai-agent/templates/config.yml.j2

topics:
{%- for topic_name, topic_config in telegram_ai_agent_topics_with_ids.items() %}
  {{ topic_name }}:
    chat_id: {{ topic_config.chat_id }}
    thread_id: {{ topic_config.thread_id }}
    engine: {{ topic_config.engine }}
    cwd: "{{ topic_config.cwd }}"
    mode: {{ topic_config.mode }}
    exec_mode: {{ topic_config.exec_mode }}
    stream_mode: {{ topic_config.stream_mode }}
    {%- if topic_config.engine == "claude" %}
    model: claude-opus-4-1
    {%- elif topic_config.engine == "codex" %}
    model: codex-latest
    {%- endif %}
{%- endfor %}

# Feature toggles per topic (§2.4 matrix in tech-spec)
features:
  core:
    autopilot: false
    aidefence: false
    rag_memory: true
  mcp:
    autopilot: false
    aidefence: false
    rag_memory: true
  wasm:
    autopilot: false
    aidefence: true
    rag_memory: true
  demo-client:
    autopilot: true
    aidefence: true
    rag_memory: true
  docs:
    autopilot: true
    aidefence: true
    rag_memory: true
  loop:
    autopilot: false
    aidefence: true
    rag_memory: true
  protocol-qa:
    autopilot: false
    aidefence: true
    rag_memory: false
  ops:
    autopilot: false
    aidefence: true
    rag_memory: true

# Memory namespaces per topic
memory:
  core:
    namespace: mnemonic-core
    mode: local
  mcp:
    namespace: mnemonic-mcp
    mode: local
  wasm:
    namespace: mnemonic-wasm
    mode: local
  demo-client:
    namespace: mnemonic-demo-client
    mode: local
  docs:
    namespace: mnemonic-docs
    mode: local
  loop:
    namespace: mnemonic-loop
    mode: local
  protocol-qa:
    namespace: mnemonic-qa
    mode: full
  ops:
    namespace: mnemonic-ops
    mode: local

# Logging configuration
logging:
  level: "{{ telegram_ai_agent_log_level | default('info') }}"
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
