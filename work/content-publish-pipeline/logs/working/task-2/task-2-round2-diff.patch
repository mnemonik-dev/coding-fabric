 # and expose it as fact `mnemonic_mcp_binary` for downstream roles (Task 3
 # templates `/etc/blogger.mcp.json` from this fact).
 
+# When the role is disabled, set the fact to an empty sentinel so downstream
+# roles that reference `mnemonic_mcp_binary` (Task 3's blogger.mcp.json
+# template) get a clearly-empty `command:` field rather than a cryptic
+# Jinja `UndefinedError`. The downstream service will fail-loud on the
+# empty command at start, which is the right failure mode.
+- name: Set empty mnemonic_mcp_binary sentinel when role is disabled
+  ansible.builtin.set_fact:
+    mnemonic_mcp_binary: ""
+  when: not (mnemonic_mcp_enabled | bool)
