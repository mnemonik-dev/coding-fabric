version: '3.8'

services:
  vaultwarden:
    image: {{ vaultwarden_image }}
    container_name: vaultwarden-vaultwarden-1
    restart: unless-stopped
    env_file:
      - .env
    environment:
      DOMAIN: "https://{{ vaultwarden_tailnet_domain }}"
      LOG_LEVEL: "info"
      EXTENDED_LOGGING: "true"
      LOG_FILE: "/data/vaultwarden.log"
      SHOW_PASSWORD_HINT: "false"
      INVITATIONS_ALLOWED: "true"
      INVITATION_ORG_NAME: "Mnemonic Fabric"
    volumes:
      - ./data:/data
    networks:
      - vaultwarden
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:80/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    # NOTE: vaultwarden intentionally has NO depends_on.  Caddy is the reverse
    # proxy in front of vaultwarden — only caddy needs to wait for vaultwarden
    # to be healthy.  The previous bidirectional `depends_on` produced a
    # `circular reference: vaultwarden -> caddy -> vaultwarden` error from
    # docker compose and prevented the stack from starting (audit T20-HIGH).

  caddy:
    image: {{ vaultwarden_caddy_image }}
    container_name: vaultwarden-caddy-1
    restart: unless-stopped
    ports:
      - "{{ tailscale_ip }}:{{ vaultwarden_https_port }}:8443/tcp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./caddy_data:/data
      - ./caddy_config:/config
    networks:
      - vaultwarden
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:2019/config/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    depends_on:
      vaultwarden:
        condition: service_healthy

networks:
  vaultwarden:
    driver: bridge

volumes:
  caddy_data:
    driver: local
  caddy_config:
    driver: local
