# Store real values only in the SOPS-rendered /opt/universal-paywall-staging/.env
# on the fabric VM (mode 0600). Never commit that file.
FACILITATOR_IMAGE=ghcr.io/mnemonik-dev/universal-paywall-facilitator@sha256:REPLACE_WITH_64_HEX_DIGEST
APPROVAL_UI_IMAGE=ghcr.io/mnemonik-dev/universal-paywall-approval-ui@sha256:REPLACE_WITH_64_HEX_DIGEST
MCP_IMAGE=ghcr.io/mnemonik-xyz/mnemonic-mcp@sha256:REPLACE_WITH_64_HEX_DIGEST
FACILITATOR_PORT=8403
MCP_PORT=3001
CADDY_NETWORK_NAME=vaultwarden_vaultwarden
# This is the only MCP → facilitator location contract. The co-located
# reference uses the Docker DNS name; a split deployment uses an HTTPS,
# private/Tailscale endpoint on the facilitator host.
UNIVERSAL_PAYWALL_URL=http://facilitator:8403

# Base Sepolia only. Base mainnet (8453) is prohibited by the deploy workflow.
ARC_RPC_URL=https://base-sepolia.example-rpc.invalid
CHAIN_ID=84532
NETWORK=base-sepolia
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_EIP712_NAME=USDC
USDC_EIP712_VERSION=2
SERVICE_ID=mnemonic-anchor-staging
SERVICE_PAY_TO=0x0000000000000000000000000000000000000000
FACILITATOR_KEY=0xREPLACE_WITH_STAGING_ONLY_PRIVATE_KEY
SESSION_STAKE_VAULT_FACTORY=0x0000000000000000000000000000000000000000
SESSION_RAIL_FROM_BLOCK=0
QUOTE_TTL_SECONDS=300
MAX_SESSION_SECONDS=604800
SERVICE_API_KEYS=REPLACE_WITH_LONG_RANDOM_STAGING_KEY
RECEIPT_KEY_ID=staging-2026-07
EXACT_PAYMENTS_ENABLED=1

# Mnemonic MCP staging configuration. Supply all secret values via the
# SOPS-rendered file; no approval mock signer is permitted.
MCP_PUBLIC_BASE_URL=https://mcp-staging.mnemonic-fabric.ts
UNIVERSAL_PAYWALL_API_KEY=REPLACE_WITH_SAME_SERVICE_API_KEY
UNIVERSAL_PAYWALL_NETWORK=eip155:84532
UNIVERSAL_PAYWALL_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
UNIVERSAL_PAYWALL_PAY_TO=0x0000000000000000000000000000000000000000
UNIVERSAL_PAYWALL_APPROVAL_URL_BASE=https://mcp-staging.mnemonic-fabric.ts
UNIVERSAL_PAYWALL_EIP712_NAME=USDC
UNIVERSAL_PAYWALL_EIP712_VERSION=2
UNIVERSAL_PAYWALL_CHAIN_RPC_URL=https://base-sepolia.example-rpc.invalid
UNIVERSAL_PAYWALL_CHAIN_NAME=Base Sepolia
UNIVERSAL_PAYWALL_CHAIN_CURRENCY_SYMBOL=ETH
UNIVERSAL_PAYWALL_CHAIN_CURRENCY_DECIMALS=18
