[Unit]
Description=workspace-manager — per-task git worktree lifecycle service
Documentation=https://github.com/mnemonic-org/coding-fabric
After=network-online.target tailscaled.service
Wants=network-online.target
OnFailure=workspace-manager-notify-failure@%n.service

[Service]
Type=simple
User=op
Group=op

# Bind to the tailnet IP (set by Ansible at deploy time).
# Never 0.0.0.0 — tech-spec D9 / AC4.
Environment=BIND_IP={{ tailscale_ip }}
Environment=BIND_PORT=8080
Environment=WORKTREES_ROOT=/home/op/code/mnemonic-workspaces
Environment=REPOS_ROOT=/home/op/code/mnemonic-masters
Environment=SCCACHE_DIR=/home/op/.cache/sccache
Environment=STATE_FILE=/home/op/.fabric/workspace-manager/state.json
Environment=LOG_FILE=/home/op/.fabric/logs/sanitized/workspace-manager.log
Environment=LOG_LEVEL=INFO

# Bitwarden session token loaded via LoadCredential — never on disk as an env var.
# The credential file is read at /run/credentials/workspace-manager.service/bw-session
LoadCredential=bw-session:/etc/fabric/credentials/bw-session

WorkingDirectory=/home/op/.fabric/workspace-manager
ExecStart=/home/op/.fabric/workspace-manager/.venv/bin/python \
    -m uvicorn main:app \
    --host ${BIND_IP} \
    --port ${BIND_PORT} \
    --no-access-log

Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ReadWritePaths=/home/op/.fabric /home/op/code/mnemonic-workspaces /home/op/.cache/sccache
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=yes
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
