# /etc/blogger.env — secrets and config for content-publisher.service
# Rendered by the content-publisher Ansible role at deploy time from sops.
# Mode 0600 root:root — only root and the service (via EnvironmentFile=)
# read this file. DO NOT edit by hand on the VM; redeploy to rotate.
# Tech-spec: work/content-publish-pipeline/tech-spec.md (Data Models /etc/blogger.env)

# Publisher bot token (separate from operator bot — Decision 5).
# Token values are quoted defense-in-depth — current BotFather tokens
# are URL-safe, but quoting prevents systemd from word-splitting on a
# hypothetical future format with spaces or '#'. (security-auditor T3-SEC-007)
TELEGRAM_BOT_TOKEN="{{ blogger_telegram_bot_token }}"
TELEGRAM_CHANNEL="{{ blogger_telegram_channel | default('@mnemonik') }}"

# Forum chat + topic for the operator-facing dispatch surface (Decision 13).
# OPERATOR_USER_ID takes the FIRST entry of telegram_ai_agent_allowed_user_ids
# — same list the operator-bot uses (deploy.yml line ~322). Empty list →
# IndexError at render, which is the fail-loud behaviour we want.
TELEGRAM_FORUM_CHAT_ID={{ telegram_forum_chat_id }}
BLOGGER_PROMPTS_TOPIC_ID={{ blogger_prompts_topic_id }}
OPERATOR_USER_ID={{ telegram_ai_agent_allowed_user_ids[0] }}

# HMAC secrets for callback_data integrity (Decision 9).
# Format: "<current>" or "<current>,<previous>" for zero-downtime rotation.
CALLBACK_HMAC_SECRETS="{{ publish_callback_hmac_secrets }}"

# Publish mode + two-location integrity binding (Decision 7).
# When PUBLISH_MODE=auto the worker compares PUBLISH_AUTO_MODE_TOKEN here
# to the sops-stored value at startup; mismatch → loud abort.
PUBLISH_MODE={{ publish_mode | default('approval') }}
PUBLISH_AUTO_MODE_TOKEN="{{ publish_auto_mode_token | default('') }}"
PUBLISH_APPROVAL_TIMEOUT_MIN={{ publish_approval_timeout_min | default(5) }}

# Score gate (analyze_blog.py) + claude-blog skill suite location.
MNEMONIK_CLAUDE_BLOG_PATH={{ claude_blog_install_dir }}
MNEMONIK_MIN_SCORE={{ publish_min_score | default(80) }}

# Queue + worktree paths. Queue lives on the persistent volume so it
# survives VM destroy-recreate; worktrees are ephemeral on root disk.
CONTENT_PUBLISHER_QUEUE={{ content_publisher_volume_mount }}/content-publisher/queue.jsonl
CONTENT_PUBLISHER_WORKTREE_ROOT={{ content_publisher_work_dir }}

# Set to "true" to run blogger in dry-run (no real Telegram posts).
MNEMONIK_DRY_RUN={{ mnemonik_dry_run | default('false') }}
